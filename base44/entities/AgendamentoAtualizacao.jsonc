{
  "name": "AgendamentoAtualizacao",
  "type": "object",
  "properties": {
    "data_agendada": {
      "type": "string",
      "format": "date-time",
      "description": "Data e hora agendada para for\u00e7ar a atualiza\u00e7\u00e3o"
    },
    "titulo": {
      "type": "string",
      "description": "T\u00edtulo da atualiza\u00e7\u00e3o"
    },
    "descricao": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o do que ser\u00e1 atualizado"
    },
    "executado": {
      "type": "boolean",
      "default": false,
      "description": "Se a atualiza\u00e7\u00e3o j\u00e1 foi executada"
    },
    "data_execucao": {
      "type": "string",
      "format": "date-time",
      "description": "Quando foi executada"
    },
    "tipo": {
      "type": "string",
      "enum": [
        "forcada",
        "notificacao"
      ],
      "default": "forcada",
      "description": "Tipo de atualiza\u00e7\u00e3o agendada"
    }
  },
  "required": [
    "data_agendada",
    "titulo"
  ]
}