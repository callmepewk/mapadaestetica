{
  "name": "VersaoSistema",
  "type": "object",
  "properties": {
    "numero_versao": {
      "type": "string",
      "description": "N\u00famero da vers\u00e3o (ex: 1.0, 1.1, 1.2)",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "titulo": {
      "type": "string",
      "description": "T\u00edtulo da vers\u00e3o/atualiza\u00e7\u00e3o"
    },
    "descricao": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o das mudan\u00e7as"
    },
    "conteudo_detalhado": {
      "type": "string",
      "description": "Changelog completo"
    },
    "data_lancamento": {
      "type": "string",
      "format": "date-time",
      "description": "Data e hora do lan\u00e7amento"
    },
    "data_agendamento": {
      "type": "string",
      "format": "date-time",
      "description": "Data e hora agendada para lan\u00e7amento"
    },
    "status": {
      "type": "string",
      "enum": [
        "atual",
        "anterior",
        "agendada"
      ],
      "default": "agendada",
      "description": "Status da vers\u00e3o"
    },
    "usuarios_nesta_versao": {
      "type": "number",
      "default": 0,
      "description": "Quantos usu\u00e1rios est\u00e3o nesta vers\u00e3o"
    },
    "notificacoes_enviadas": {
      "type": "boolean",
      "default": false,
      "description": "Se as notifica\u00e7\u00f5es por email foram enviadas"
    },
    "forcada": {
      "type": "boolean",
      "default": false,
      "description": "Se foi uma atualiza\u00e7\u00e3o for\u00e7ada"
    }
  },
  "required": [
    "numero_versao",
    "titulo",
    "data_lancamento"
  ]
}