{
  "name": "SolicitacaoImpulsionamento",
  "type": "object",
  "properties": {
    "usuario_email": {
      "type": "string",
      "description": "Email do usu\u00e1rio"
    },
    "usuario_nome": {
      "type": "string",
      "description": "Nome do usu\u00e1rio"
    },
    "anuncio_id": {
      "type": "string",
      "description": "ID do an\u00fancio a ser impulsionado"
    },
    "anuncio_titulo": {
      "type": "string",
      "description": "T\u00edtulo do an\u00fancio"
    },
    "plano_impulsionamento": {
      "type": "string",
      "enum": [
        "basico",
        "intermediario",
        "turbo"
      ],
      "description": "Plano de impulsionamento escolhido"
    },
    "duracao_dias": {
      "type": "number",
      "description": "Dura\u00e7\u00e3o em dias"
    },
    "valor": {
      "type": "number",
      "description": "Valor pago"
    },
    "link_mercadopago": {
      "type": "string",
      "description": "Link do Mercado Pago usado"
    },
    "status": {
      "type": "string",
      "enum": [
        "aguardando_confirmacao",
        "confirmado_usuario",
        "pagamento_aprovado_mp",
        "pagamento_pendente_mp",
        "pagamento_rejeitado_mp",
        "ativado_admin",
        "cancelado"
      ],
      "default": "aguardando_confirmacao",
      "description": "Status da solicita\u00e7\u00e3o"
    },
    "data_solicitacao": {
      "type": "string",
      "format": "date-time",
      "description": "Data da solicita\u00e7\u00e3o"
    },
    "data_confirmacao_usuario": {
      "type": "string",
      "format": "date-time",
      "description": "Data que o usu\u00e1rio confirmou o pagamento"
    },
    "data_pagamento_mp": {
      "type": "string",
      "format": "date-time",
      "description": "Data que o Mercado Pago retornou o status"
    },
    "data_ativacao": {
      "type": "string",
      "format": "date-time",
      "description": "Data que foi ativado pelo admin"
    },
    "data_inicio_impulsionamento": {
      "type": "string",
      "format": "date-time",
      "description": "Data de in\u00edcio do impulsionamento"
    },
    "data_fim_impulsionamento": {
      "type": "string",
      "format": "date-time",
      "description": "Data de fim do impulsionamento"
    },
    "observacoes": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es do suporte"
    }
  },
  "required": [
    "usuario_email",
    "usuario_nome",
    "anuncio_id",
    "anuncio_titulo",
    "plano_impulsionamento",
    "duracao_dias",
    "valor"
  ]
}