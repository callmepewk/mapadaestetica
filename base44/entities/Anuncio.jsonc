{
  "name": "Anuncio",
  "type": "object",
  "properties": {
    "tipo_anuncio": {
      "type": "string",
      "enum": [
        "servico",
        "procedimento",
        "tecnica",
        "consultorio",
        "clinica",
        "promocao",
        "venda_produto",
        "venda_aparelho",
        "aluguel_produto",
        "aluguel_aparelho",
        "troca_produto",
        "troca_aparelho",
        "venda_moveis",
        "troca_moveis",
        "evento",
        "ia",
        "servicos",
        "servicos_ia",
        "midia_marketing",
        "inauguracao",
        "reinauguracao",
        "lancamento_produto",
        "lancamento_servico",
        "lancamento_tratamento"
      ],
      "description": "Tipo do an\u00fancio"
    },
    "titulo": {
      "type": "string",
      "description": "T\u00edtulo do an\u00fancio"
    },
    "descricao": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o detalhada do servi\u00e7o"
    },
    "categoria": {
      "type": "string",
      "enum": [
        "Est\u00e9tica Facial - Tratamentos B\u00e1sicos",
        "Est\u00e9tica Facial - Rejuvenescimento",
        "Est\u00e9tica Facial - Tratamento de Condi\u00e7\u00f5es",
        "Est\u00e9tica Facial - Harmoniza\u00e7\u00e3o",
        "Est\u00e9tica Corporal - Redu\u00e7\u00e3o de Medidas",
