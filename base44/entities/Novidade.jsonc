{
  "name": "Novidade",
  "type": "object",
  "properties": {
    "titulo": {
      "type": "string",
      "description": "T\u00edtulo da novidade"
    },
    "descricao": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o da atualiza\u00e7\u00e3o"
    },
    "conteudo_detalhado": {
      "type": "string",
      "description": "Conte\u00fado completo da novidade"
    },
    "data_publicacao": {
      "type": "string",
      "format": "date-time",
      "description": "Data e hor\u00e1rio de publica\u00e7\u00e3o"
    },
    "categoria": {
      "type": "string",
      "enum": [
        "nova_funcionalidade",
        "melhoria",
        "correcao",
        "anuncio"
      ],
      "default": "nova_funcionalidade",
      "description": "Categoria da novidade"
    },
    "icone": {
      "type": "string",
      "description": "Emoji ou \u00edcone da novidade"
    },
    "imagem": {
      "type": "string",
      "description": "URL da imagem ilustrativa"
    },
    "status": {
      "type": "string",
      "enum": [
        "publicado",
        "rascunho",
        "programado"
      ],
      "default": "rascunho"
    },
    "visualizacoes": {
      "type": "number",
      "default": 0
    },
    "curtidas": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "titulo",
    "descricao",
    "data_publicacao"
  ]
}