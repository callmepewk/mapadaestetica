      "type": "string",
      "enum": [
        "medico",
        "dermatologista",
        "biomedico_esteta",
        "dentista_harmonizador",
        "enfermeiro_esteta",
        "farmaceutico_esteta",
        "fisioterapeuta_dermatofuncional",
        "esteticista",
        "cosmetologo",
        "terapeuta_capilar",
        "especialista_micropigmentacao",
        "especialista_lash_design",
        "especialista_depilacao",
        "massoterapeuta",
        "designer_sobrancelhas",
        "tecnico_estetica",
        "outra"
      ],
      "description": "Profiss\u00e3o principal do profissional de est\u00e9tica"
    },
    "profissao_outro": {
      "type": "string",
      "description": "Campo livre quando a profiss\u00e3o for 'outra'"
